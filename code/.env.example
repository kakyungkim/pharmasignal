# cp .env.example .env  후 값 채우기

# 1) Bright Data — 대시보드 > Web Unlocker zone > Overview
BRIGHTDATA_API_KEY=
# Bright Data는 제품이 여러 개다. 계정에 열려 있는 것부터 채운다.
BD_ZONE=web_unlocker1        # 제품 1: Web Unlocker zone 이름
BD_SERP_ZONE=                # 제품 2: SERP API zone 이름
# Web Unlocker가 없는 계정은 프록시 Access parameters를 쓴다
BD_PROXY_USER=
BD_PROXY_PASS=

# 2) Qwen Cloud (DashScope 호환)
DASHSCOPE_API_KEY=
QWEN_MODEL=qwen3.8-max
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

# 3) Daytona — 대시보드 > API Keys
DAYTONA_API_KEY=

# 4) Nosana — 템플릿 배포 후 받은 추론 엔드포인트 (OpenAI 호환이면 /v1 까지)
NOSANA_BASE_URL=
NOSANA_API_KEY=nosana
NOSANA_MODEL=
